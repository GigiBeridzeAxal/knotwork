{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "knotwork",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // The dashboard is a single-page app. /api and /hooks go to the Worker, everything else is static.
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/hooks/*"]
  },
  // Data lives in MongoDB Atlas (free M0 cluster). Two secrets, set once with `npx wrangler secret put`:
  // MONGODB_URI (the connection string) and AUTH_PEPPER (a long random string mixed into password
  // hashes). Locally both come from .dev.vars (see README).
  "vars": { "MONGODB_DB": "knotwork" },
  // The API, webhooks and cron tick run in one Durable Object (worker/hub.ts) that keeps its database
  // connection open between requests, placed in western Europe next to the cluster. Opening a
  // connection per request would cost more CPU than the free plan allows. (SQLite-backed Durable
  // Objects are on the free plan; this one stores nothing itself.)
  "durable_objects": { "bindings": [{ "name": "HUB", "class_name": "Hub" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Hub"] }],
  // Cloudflare's free rate limiter. For /api: 60 requests a minute per IP (or IPv6 /64), checked in
  // the Worker before the request is passed to the hub, so a refused one costs no hub request.
  // Matches LIMITS.requestsPerIpPerMinute. For /hooks: the Worker refuses made-up keys by their
  // signature; calls with a real key are limited inside the hub, before any database work, to 60 a
  // minute per webhook URL (IP_LIMITER with a hook key) and a looser per-IP limit (HOOK_IP_LIMITER),
  // so those do count as hub requests when refused (worker/index.ts).
  // (Refused requests still count toward the Worker's 100k a day; see "Deploy" in the README for
  // the free WAF rule that stops floods before they reach the Worker.)
  "ratelimits": [
    { "name": "IP_LIMITER", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } },
    { "name": "HOOK_IP_LIMITER", "namespace_id": "1002", "simple": { "limit": 600, "period": 60 } },
    // The same per network (IPv6 /48): 600 a minute for /api and 3,000 for /hooks.
    { "name": "NET_LIMITER", "namespace_id": "1003", "simple": { "limit": 600, "period": 60 } },
    { "name": "HOOK_NET_LIMITER", "namespace_id": "1004", "simple": { "limit": 3000, "period": 60 } }
  ],
  // Every minute: start scheduled workflows and resume runs that are waiting on a retry or a delay.
  "triggers": { "crons": ["* * * * *"] },
  // Served at knotwork.gigiberidze.com. Cloudflare creates the DNS record and certificate on deploy.
  "routes": [{ "pattern": "knotwork.gigiberidze.com", "custom_domain": true }],
  "observability": { "enabled": true }
}

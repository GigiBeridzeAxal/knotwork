{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "knotwork",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // The dashboard is a single-page app. /api and /hooks go to the Worker, everything else is static.
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/hooks/*"]
  },
  // Data lives in MongoDB Atlas (free M0 cluster). Two secrets, set once with `npx wrangler secret put`:
  // MONGODB_URI (the connection string) and AUTH_PEPPER (a long random string mixed into password
  // hashes). Locally both come from .dev.vars (see README).
  "vars": { "MONGODB_DB": "knotwork" },
  // Run the Worker near the database instead of near the visitor: each request opens a database
  // connection, and the handshake is several round trips.
  "placement": { "mode": "smart" },
  // Cloudflare's free rate limiter: 60 requests a minute per IP (or IPv6 /64) to /api, and 60 calls a
  // minute per webhook URL, turned away before the Worker opens a database connection. Matches
  // LIMITS.requestsPerIpPerMinute. HOOK_IP_LIMITER is a looser per-IP limit for /hooks, so random
  // webhook keys can't be used to make unlimited database lookups (worker/index.ts).
  // (Turned-away requests still count toward the 100k a day; see "Deploy" in the README for the
  // free WAF rule that stops floods before they reach the Worker.)
  "ratelimits": [
    { "name": "IP_LIMITER", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } },
    { "name": "HOOK_IP_LIMITER", "namespace_id": "1002", "simple": { "limit": 600, "period": 60 } }
  ],
  // Every minute: start scheduled workflows and resume runs that are waiting on a retry or a delay.
  "triggers": { "crons": ["* * * * *"] },
  // Served at knotwork.gigiberidze.com. Cloudflare creates the DNS record and certificate on deploy.
  "routes": [{ "pattern": "knotwork.gigiberidze.com", "custom_domain": true }],
  "observability": { "enabled": true }
}
